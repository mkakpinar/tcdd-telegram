BOT_TOKEN=
REDIS_URL=redis://default:PASSWORD@HOST:6379
ADMIN_CHAT_ID=
# Comma-separated chat IDs allowed to use the bot. Empty = open to everyone.
# ADMIN_CHAT_ID is always allowed. e.g. ALLOWED_CHAT_IDS=12345,67890
ALLOWED_CHAT_IDS=
TIMEZONE=Europe/Istanbul
LOG_LEVEL=INFO
MAX_ALARMS_PER_USER=5
SEARCH_RATE_PER_HOUR=10
# How often the alarm checker runs, in minutes (default 10). Lower = faster
# alerts but more load on TCDD; going below ~5 risks rate-limiting.
CHECK_INTERVAL_MIN=10
TCDD_MODE=live
